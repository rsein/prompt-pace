# Copie este arquivo para .env.local e preencha com os valores do seu projeto

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Supabase > Project Settings > API > service_role (ou "secret" / sb_secret_...)
# NUNCA exponha essa chave no navegador — só é usada em rotas de API server-side,
# pra poder ler/gravar dados de OUTROS usuários (ex: mandar notificação pros outros membros).
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Anthropic > console.anthropic.com > API Keys
# Usada só no servidor (rota /api/narrator — o comentário do narrador), nunca exposta ao navegador
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI > platform.openai.com > API Keys
# Usada só no servidor (rota /api/scan-run — leitura da foto do relógio/app), nunca exposta ao navegador
OPENAI_API_KEY=sk-...

# Notificações push — gere rodando `npx web-push generate-vapid-keys` no terminal
# (depois do npm install). NEXT_PUBLIC_VAPID_PUBLIC_KEY pode ficar exposta ao navegador,
# a privada nunca.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# URL pública onde o app está rodando (sem barra no final). Usada pra montar o redirect_uri
# do OAuth do Strava. Em desenvolvimento: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Strava > strava.com/settings/api (crie um app, "Authorization Callback Domain" deve ser
# o domínio do NEXT_PUBLIC_APP_URL acima, ex: localhost em dev, seu-dominio.com em produção)
# Usada pra sincronizar corridas registradas no Strava.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Garmin e Samsung Health: a estrutura já está pronta no banco (tabela wearable_connections)
# e a tela de Perfil já mostra os dois provedores como "Em breve", mas não dá pra ligar de
# verdade ainda — ambos exigem aprovação prévia do fabricante (ver README, seção "Sincronização").
